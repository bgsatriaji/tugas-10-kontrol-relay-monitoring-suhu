  {
    "id": "p10_relay_status_filter",
    "type": "function",
    "z": "p10_tab",
    "name": "Status relay valid",
    "func": "const s = String(msg.payload).trim().toUpperCase();\nif (s !== \"ON\" && s !== \"OFF\") return null;\nmsg.payload = s;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
