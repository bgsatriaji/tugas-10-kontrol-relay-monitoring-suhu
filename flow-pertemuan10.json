  {
    "id": "p10_suhu_parse",
    "type": "function",
    "z": "p10_tab",
    "name": "Validasi suhu (Number)",
    "func": "const nilai = Number(msg.payload);\nif (!Number.isFinite(nilai) || nilai < -40 || nilai > 125) { node.warn(\"Data suhu tidak valid: \" + msg.payload); return null; }\nmsg.payload = Number(nilai.toFixed(2));\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 385,
    "y": 100,
    "wires": [
      [
        "p10_gauge",
        "p10_chart",
        "p10_debug_suhu"
      ]
    ]
  },
