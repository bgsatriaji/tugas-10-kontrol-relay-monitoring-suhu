  {
    "id": "p10_pwm_validate",
    "type": "function",
    "z": "p10_tab",
    "name": "Validasi PWM 0..255",
    "func": "const angka = Number(msg.payload);\nif (!Number.isFinite(angka)) return null;\nmsg.payload = Math.max(0, Math.min(255, Math.round(angka)));\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
